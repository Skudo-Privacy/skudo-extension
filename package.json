{
  "name": "skudo-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Skudo browser extension.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{js,css,vue}\" \"test/**/*.js\"",
    "build": "node scripts/build.js --production",
    "dev": "node scripts/build.js --watch",
    "lint": "web-ext lint --source-dir=dist --no-config-discovery",
    "pack": "web-ext build --source-dir=dist --artifacts-dir=. --overwrite-dest --no-config-discovery",
    "firefox": "web-ext run --source-dir=dist --no-config-discovery"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.0.0",
    "prettier": "^3.5.3",
    "vitest": "^4.0.0",
    "web-ext": "^10.6.0"
  }
}
